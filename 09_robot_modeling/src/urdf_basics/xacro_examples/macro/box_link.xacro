<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- 宏定义 -->
    <xacro:macro name="box_link"
                params="name length width height">
        <link name="${name}">
            <visual>
                <geometry>
                    <box size="${length} ${width} ${height}"/>
                </geometry>
            </visual>
        </link>
    </xacro:macro>

    <xacro:macro name="box_joint"
                params="name xyz">
        <joint name="${name}_joint" type="fixed">
            <parent link="base_footprint"/>
            <child link="${name}"/>
            <origin xyz="${xyz}"/>
        </joint>
    </xacro:macro>

    <!-- 普通URDF元素 -->
    <link name="base_footprint"/>
</robot>
