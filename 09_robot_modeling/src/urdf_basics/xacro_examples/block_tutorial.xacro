<?xml version="1.0"?>
<robot name="block_demo"
       xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- 车身 -->
    <link name="base_link"/>

    <!-- 传感器安装宏 -->
    <xacro:macro name="sensor_mount" params="name *block">
        <link name="${name}_link"/>
        <joint name="${name}_joint" type="fixed">
            <parent link="base_link"/>
            <child link="${name}_link"/>
            <xacro:insert_block name="block"/>
        </joint>
    </xacro:macro>

    <!-- 安装LiDAR -->
    <xacro:sensor_mount name="lidar">
        <origin xyz="0 0 0.13" rpy="0 0 0"/>
    </xacro:sensor_mount>

    <!-- 安装Camera -->
    <xacro:sensor_mount name="camera">
        <origin xyz="0.25 0 0.05" rpy="0 0 0"/>
    </xacro:sensor_mount>
</robot>
