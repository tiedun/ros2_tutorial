<?xml version="1.0"?>
<robot name="joint_fixed_basic">
    <material name="blue">
        <color rgba="0.15 0.55 0.90 1.0"/>
    </material>
    <material name="orange">
        <color rgba="0.95 0.55 0.15 1.0"/>
    </material>

    <!-- 车身 -->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0.1"/>
            <geometry>
                <box size="0.5 0.4 0.2"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <!-- 连杆：从自身原点沿X轴正方向延伸 -->
    <link name="arm_link">
        <visual>
            <origin xyz="0.3 0 0.2"/>
            <geometry>
                <box size="0.6 0.08 0.08"/>
            </geometry>
            <material name="orange"/>
        </visual>
    </link>

    <!-- 固定关节 -->
    <joint name="arm_joint" type="fixed">
        <parent link="base_link"/>
        <child link="arm_link"/>
    </joint>
</robot>
