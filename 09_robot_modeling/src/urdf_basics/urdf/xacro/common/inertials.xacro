<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- 均匀长方体 -->
    <xacro:macro name="box_inertial" params="mass x y z">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="${mass}"/>
            <inertia
                ixx="${mass*(y*y+z*z)/12}" ixy="0" ixz="0"
                iyy="${mass*(x*x+z*z)/12}" iyz="0"
                izz="${mass*(x*x+y*y)/12}"/>
        </inertial>
    </xacro:macro>

    <!-- 均匀实心圆柱体：中心轴沿Y轴 -->
    <xacro:macro name="cylinder_y_inertial"
                 params="mass radius length">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="${mass}"/>
            <inertia
                ixx="${mass*(3*radius*radius+length*length)/12}"
                ixy="0" ixz="0"
                iyy="${mass*radius*radius/2}"
                iyz="0"
                izz="${mass*(3*radius*radius+length*length)/12}"/>
        </inertial>
    </xacro:macro>

    <!-- 均匀实心圆柱体：中心轴沿Z轴 -->
    <xacro:macro name="cylinder_z_inertial"
                 params="mass radius length">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="${mass}"/>
            <inertia
                ixx="${mass*(3*radius*radius+length*length)/12}"
                ixy="0" ixz="0"
                iyy="${mass*(3*radius*radius+length*length)/12}"
                iyz="0"
                izz="${mass*radius*radius/2}"/>
        </inertial>
    </xacro:macro>

    <!-- 均匀实心球 -->
    <xacro:macro name="sphere_inertial" params="mass radius">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="${mass}"/>
            <inertia
                ixx="${2*mass*radius*radius/5}" ixy="0" ixz="0"
                iyy="${2*mass*radius*radius/5}" iyz="0"
                izz="${2*mass*radius*radius/5}"/>
        </inertial>
    </xacro:macro>

</robot>
