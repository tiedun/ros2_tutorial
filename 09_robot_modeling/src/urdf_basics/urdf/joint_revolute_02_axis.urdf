<?xml version="1.0"?>
<robot name="joint_revolute_axis">
    <material name="blue">
        <color rgba="0.15 0.55 0.90 1.0"/>
    </material>
    <material name="orange">
        <color rgba="0.95 0.55 0.15 1.0"/>
    </material>

    <link name="base_link">
        <!-- 车身 -->
        <visual>
            <origin xyz="0 0 0.1"/>
            <geometry>
                <box size="0.5 0.4 0.2"/>
            </geometry>
            <material name="blue"/>
        </visual>

        <!-- 圆柱形安装座 -->
        <visual>
            <origin xyz="0 0 0.25"/>
            <geometry>
                <cylinder radius="0.06" length="0.1"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <link name="arm_link">
        <visual>
            <origin xyz="0.3 0 0"/>
            <geometry>
                <box size="0.6 0.08 0.08"/>
            </geometry>
            <material name="orange"/>
        </visual>
    </link>

    <joint name="arm_joint" type="revolute">
        <parent link="base_link"/>
        <child link="arm_link"/>
        <origin xyz="0 0 0.34" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-3.141592653" upper="0"
               effort="10.0" velocity="1.0"/>
    </joint>
</robot>
