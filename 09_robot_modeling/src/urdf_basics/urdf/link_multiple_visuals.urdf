<?xml version="1.0"?>
<robot name="multiple_visuals_robot">

    <!-- 统一材质 -->
    <material name="blue">
        <color rgba="0.15 0.55 0.90 1.0"/>
    </material>

    <link name="base_link">
        <!-- 底部防护边缘 -->
        <visual>
            <origin xyz="0 0 0.10"/>
            <geometry>
                <cylinder radius="0.34" length="0.07"/>
            </geometry>
            <material name="blue"/>
        </visual>

        <!-- 圆形车身主体 -->
        <visual>
            <origin xyz="0 0 0.17"/>
            <geometry>
                <cylinder radius="0.32" length="0.13"/>
            </geometry>
            <material name="blue"/>
        </visual>

        <!-- 顶部外壳：中央部分 -->
        <visual>
            <origin xyz="0 0 0.26"/>
            <geometry>
                <box size="0.30 0.28 0.07"/>
            </geometry>
            <material name="blue"/>
        </visual>

        <!-- 顶部外壳：前端圆弧 -->
        <visual>
            <origin xyz="0.15 0 0.26"/>
            <geometry>
                <cylinder radius="0.14" length="0.065"/>
            </geometry>
            <material name="blue"/>
        </visual>

        <!-- 顶部外壳：后端圆弧 -->
        <visual>
            <origin xyz="-0.15 0 0.26"/>
            <geometry>
                <cylinder radius="0.14" length="0.065"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>
</robot>
