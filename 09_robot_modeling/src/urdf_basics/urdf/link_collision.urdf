<?xml version="1.0"?>
<robot name="link_collision_robot">
    <material name="blue">
        <color rgba="0.15 0.55 0.90 1.0"/>
    </material>

    <link name="base_link">
        <!-- Visual：由两个几何形状构成外观 -->
        <!-- 底部车身 -->
        <visual>
            <origin xyz="0 0 0.1"/>
            <geometry>
                <box size="0.6 0.4 0.2"/>
            </geometry>
            <material name="blue"/>
        </visual>

        <!-- 顶部凸起结构 -->
        <visual>
            <origin xyz="0 0 0.3"/>
            <geometry>
                <cylinder radius="0.1" length="0.2"/>
            </geometry>
            <material name="blue"/>
        </visual>

        <!-- Collision：使用一个长方体近似整体外形 -->
        <collision>
            <origin xyz="0 0 0.2"/>
            <geometry>
                <box size="0.6 0.4 0.4"/>
            </geometry>
        </collision>
    </link>
</robot>
