<?xml version="1.0"?>
<robot name="joint_prismatic_basic">
    <material name="blue">
        <color rgba="0.15 0.55 0.90 1.0"/>
    </material>
    <material name="orange">
        <color rgba="0.95 0.55 0.15 1.0"/>
    </material>

    <!-- 底座 -->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0.1"/>
            <geometry>
                <box size="0.5 0.4 0.2"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <!-- 滑杆 -->
    <link name="slider_link">
        <visual>
            <origin xyz="0 0 0.04"/>
            <geometry>
                <box size="0.4 0.10 0.08"/>
            </geometry>
            <material name="orange"/>
        </visual>
    </link>

    <!-- 移动关节 -->
    <joint name="slider_joint" type="prismatic">
        <parent link="base_link"/>
        <child link="slider_link"/>
        <origin xyz="0 0 0.2"/>
        <axis xyz="1 0 0"/>
        <limit lower="0.0" upper="0.3"
               effort="20.0" velocity="0.2"/>
    </joint>
</robot>
