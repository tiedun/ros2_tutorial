<?xml version="1.0"?>
<robot name="joint_continuous_basic">
    <material name="blue">
        <color rgba="0.15 0.55 0.90 1.0"/>
    </material>
    <material name="orange">
        <color rgba="0.95 0.55 0.15 1.0"/>
    </material>

    <!-- 地面参考坐标系 -->
    <link name="base_footprint"/>

    <!-- 车身 -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.5 0.4 0.2"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <!-- 左车轮 -->
    <link name="left_wheel_link">
        <visual>
            <origin rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.12" length="0.06"/>
            </geometry>
            <material name="orange"/>
        </visual>

        <!-- 左车轮旋转标记 -->
        <visual>
            <origin xyz="0.05 0.045 -0.05" rpy="0 0.7854 0"/>
            <geometry>
                <box size="0.06 0.03 0.015"/>
            </geometry>
        </visual>
    </link>

    <!-- 右车轮 -->
    <link name="right_wheel_link">
        <visual>
            <origin rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.12" length="0.06"/>
            </geometry>
            <material name="orange"/>
        </visual>

        <!-- 右车轮旋转标记 -->
        <visual>
            <origin xyz="0.05 -0.045 -0.05" rpy="0 0.7854 0"/>
            <geometry>
                <box size="0.06 0.03 0.015"/>
            </geometry>
        </visual>
    </link>

    <!-- 地面参考坐标系与车身固定连接 -->
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.18"/>
    </joint>

    <!-- 左车轮：连续旋转关节 -->
    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel_link"/>
        <origin xyz="0 0.25 -0.06"/>
        <axis xyz="0 1 0"/>
        <limit effort="10.0" velocity="1.0"/>
    </joint>

    <!-- 右车轮：连续旋转关节 -->
    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel_link"/>
        <origin xyz="0 -0.25 -0.06"/>
        <axis xyz="0 1 0"/>
        <limit effort="10.0" velocity="1.0"/>
    </joint>
</robot>
