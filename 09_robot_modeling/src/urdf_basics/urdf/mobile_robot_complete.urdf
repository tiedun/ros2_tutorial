<?xml version="1.0"?>
<robot name="mobile_robot_complete">
    <!-- 材质定义 -->
    <material name="blue">
        <color rgba="0.15 0.55 0.90 1.0"/>
    </material>
    <material name="orange">
        <color rgba="0.95 0.55 0.15 1.0"/>
    </material>
    <material name="gray">
        <color rgba="0.60 0.66 0.72 1.0"/>
    </material>

    <!-- 虚拟地面参考坐标系 -->
    <link name="base_footprint"/>

    <!-- 车身 -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.50 0.40 0.20"/>
            </geometry>
            <material name="blue"/>
        </visual>

        <collision>
            <geometry>
                <box size="0.50 0.40 0.20"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="8.0"/>
            <inertia
                ixx="0.1333333333" ixy="0" ixz="0"
                iyy="0.1933333333" iyz="0"
                izz="0.2733333333"/>
        </inertial>
    </link>

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.25"/>
    </joint>

    <!-- 左驱动轮 -->
    <link name="left_wheel_link">
        <visual>
            <origin rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.12" length="0.06"/>
            </geometry>
            <material name="orange"/>
        </visual>

        <!-- 左轮外侧旋转标记 -->
        <visual>
            <origin xyz="0.07 0.032 0"/>
            <geometry>
                <box size="0.05 0.005 0.012"/>
            </geometry>
        </visual>

        <collision>
            <origin rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.12" length="0.06"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.8"/>
            <inertia
                ixx="0.0031200000" ixy="0" ixz="0"
                iyy="0.0057600000" iyz="0"
                izz="0.0031200000"/>
        </inertial>
    </link>

    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel_link"/>
        <origin xyz="0.08 0.23 -0.13"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- 右驱动轮 -->
    <link name="right_wheel_link">
        <visual>
            <origin rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.12" length="0.06"/>
            </geometry>
            <material name="orange"/>
        </visual>

        <!-- 右轮外侧旋转标记 -->
        <visual>
            <origin xyz="0.07 -0.032 0"/>
            <geometry>
                <box size="0.05 0.005 0.012"/>
            </geometry>
        </visual>

        <collision>
            <origin rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.12" length="0.06"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.8"/>
            <inertia
                ixx="0.0031200000" ixy="0" ixz="0"
                iyy="0.0057600000" iyz="0"
                izz="0.0031200000"/>
        </inertial>
    </link>

    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel_link"/>
        <origin xyz="0.08 -0.23 -0.13"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- 后部辅助支撑轮 -->
    <link name="caster_link">
        <visual>
            <geometry>
                <sphere radius="0.08"/>
            </geometry>
            <material name="orange"/>
        </visual>

        <collision>
            <geometry>
                <sphere radius="0.08"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.2"/>
            <inertia
                ixx="0.0005120000" ixy="0" ixz="0"
                iyy="0.0005120000" iyz="0"
                izz="0.0005120000"/>
        </inertial>
    </link>

    <joint name="caster_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_link"/>
        <origin xyz="-0.20 0 -0.17"/>
    </joint>

    <!-- 激光雷达 -->
    <link name="lidar_link">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.06"/>
            </geometry>
            <material name="gray"/>
        </visual>

        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.06"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.35"/>
            <inertia
                ixx="0.0003237500" ixy="0" ixz="0"
                iyy="0.0003237500" iyz="0"
                izz="0.0004375000"/>
        </inertial>
    </link>

    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <origin xyz="0 0 0.13"/>
    </joint>

    <!-- 摄像头 -->
    <link name="camera_link">
        <visual>
            <geometry>
                <box size="0.04 0.08 0.06"/>
            </geometry>
            <material name="gray"/>
        </visual>

        <collision>
            <geometry>
                <box size="0.04 0.08 0.06"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.15"/>
            <inertia
                ixx="0.0001250000" ixy="0" ixz="0"
                iyy="0.0000650000" iyz="0"
                izz="0.0001000000"/>
        </inertial>
    </link>

    <joint name="camera_joint" type="fixed">
        <parent link="base_link"/>
        <child link="camera_link"/>
        <origin xyz="0.27 0 0"/>
    </joint>

    <!-- 惯性测量单元 -->
    <link name="imu_link">
        <visual>
            <geometry>
                <box size="0.04 0.03 0.01"/>
            </geometry>
            <material name="gray"/>
        </visual>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.02"/>
            <inertia
                ixx="0.0000016667" ixy="0" ixz="0"
                iyy="0.0000028333" iyz="0"
                izz="0.0000041667"/>
        </inertial>
    </link>

    <joint name="imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="-0.05 0 0"/>
    </joint>
</robot>
