<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="drive_wheel" params="side sign">
        <link name="${side}_wheel_link">
            <!-- 车轮主体 -->
            <visual>
                <origin rpy="1.5708 0 0"/>
                <geometry>
                    <cylinder
                        radius="${wheel_radius}"
                        length="${wheel_width}"/>
                </geometry>
                <material name="orange"/>
            </visual>

            <!-- 车轮外侧旋转标记 -->
            <visual>
                <origin
                    xyz="${wheel_mark_x} ${float(sign)*wheel_mark_y} 0"/>
                <geometry>
                    <box
                        size="${wheel_mark_length} ${wheel_mark_width} ${wheel_mark_height}"/>
                </geometry>
            </visual>

            <collision>
                <origin rpy="1.5708 0 0"/>
                <geometry>
                    <cylinder
                        radius="${wheel_radius}"
                        length="${wheel_width}"/>
                </geometry>
            </collision>

            <xacro:cylinder_y_inertial
                mass="${wheel_mass}"
                radius="${wheel_radius}"
                length="${wheel_width}"/>
        </link>

        <joint name="${side}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${side}_wheel_link"/>
            <origin
                xyz="${wheel_x} ${float(sign)*wheel_y} ${wheel_z}"/>
            <axis xyz="0 1 0"/>
        </joint>
    </xacro:macro>
</robot>
